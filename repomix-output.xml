      createOne: vi.fn(),
      findByEmail: vi.fn(),
      find: vi.fn(),
      findById: vi.fn(),
    } as unknown as Mocked<UserRepository>;

    emailServiceMock = {
      sendEmailToSeller: vi.fn(),
    } as unknown as Mocked<EmailService>;

    templateServiceMock = {
      getBookSoldTemplate: vi.fn().mockReturnValue({
        subject: '¡Tu libro ha sido vendido!',
